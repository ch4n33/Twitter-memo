{
  "name": "X Memo",
  "description": "Save notes on X profiles.",
  "version": "0.2.0",
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "logos/16.png"
  },
  "icons": {
    "128": "logos/128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "js": [
        "scripts/shared.js",
        "scripts/content.js"
      ],
      "css": [
        "scripts/content.css"
      ],
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ]
    }
  ]
}
